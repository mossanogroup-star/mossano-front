# This package normally needs no .env at all — mossano-back serves the
# storefront, so "/api" is same-origin.
#
# VITE_* values are inlined into the client bundle and are public. Secrets live
# in mossano-back/.env.

# Only if the front is ever deployed apart from the API. Needs a rebuild.
VITE_API_BASE_URL=

# Proxy target for the standalone `npm run dev` on :5173. Unused when you
# develop through `mossano-back npm run dev`, which is the recommended way.
VITE_DEV_API_TARGET=http://localhost:5000

# Audit scripts read BASE, SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD, falling
# back to mossano-back/.env.
# BASE=http://localhost:5000
